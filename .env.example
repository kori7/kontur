LOCAL_VISION_URL=http://127.0.0.1:8081/v1
LOCAL_VISION_MODEL=Qwen3-VL-4B-Instruct
# No cloud credentials. Only a literal loopback model URL is accepted.
APP_DB_PATH=data/inspection.db
# Live inspection detector: owlvit, owlv2 or empty for none. Weights: scripts/data/prepare-detector.py
KONTUR_DETECTOR=
# Sign-in by email and password: on (default) or off for tests and demos without accounts.
KONTUR_AUTH=on
